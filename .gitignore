# Python virtual environment
.venv/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Test and tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Coverage reports
.coverage
htmlcov/

# Generated processed data
data/processed/

# Large historical/raw downloads
data/raw/**/*.zip
data/raw/**/*.sqlite
data/raw/**/*.db
data/raw/daily/*/wsc_*.csv

# Small reference/sample datasets
# These remain tracked by Git.

# Temporary files
*.tmp
*.temp
*.log

# Environment/secrets files
.env
.env.*

# VS Code settings
.vscode/

# OS-generated files
.DS_Store
Thumbs.db